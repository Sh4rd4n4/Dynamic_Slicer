{
  "privileges": [],
  "dataRoles": [
    {
      "name": "field",
      "kind": "Grouping",
      "displayName": "Field"
    }, 
    {
      "name": "dynamicSelection",
      "kind": "Grouping",
      "displayName": "Dynamic Selection"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "field": {
            "max": 1
          },
          "dynamicSelection": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "field"
              }
            },
            {
              "for": {
                "in": "dynamicSelection"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 10000
            }
          }
        }
      }
    }
  ],
  "supportsKeyboardFocus": true,
  "supportsEmptyDataView": true,
  "supportsLandingPage": true,
  "objects": {
    "general": {
      "displayName": "General",
      "properties": {
        "filter": {
          "type": {
            "filter": true
          }
        }
      }
    },
    "slicer": {
      "displayName": "Slicer",
      "properties": {
        "displayMode": {
          "displayName": "Style",
          "type": {
            "enumeration": [
              {
                "displayName": "Dropdown",
                "value": "dropdown"
              },
              {
                "displayName": "List",
                "value": "list"
              },
              {
                "displayName": "Tiles",
                "value": "tiles"
              }
            ]
          }
        },
        "showTitle": {
          "displayName": "Show slicer header",
          "type": {
            "bool": true
          }
        },
        "titleText": {
          "displayName": "Slicer header",
          "type": {
            "text": true
          }
        },
        "singleSelect": {
          "displayName": "Single select",
          "type": {
            "bool": true
          }
        },
        "multiSelectWithCtrl": {
          "displayName": "Multi-select with CTRL",
          "type": {
            "bool": true
          }
        },
        "showSelectAll": {
          "displayName": "Show \"All\" option",
          "type": {
            "bool": true
          }
        },
        "fallback": {
          "displayName": "Fallback when default is hidden",
          "type": {
            "enumeration": [
              {
                "displayName": "First in list",
                "value": "firstVisible"
              },
              {
                "displayName": "Last in list",
                "value": "lastVisible"
              },
              {
                "displayName": "Smallest value",
                "value": "smallest"
              },
              {
                "displayName": "Largest value",
                "value": "largest"
              }
            ]
          }
        }
      }
    }
  },
  "supportsHighlight": false,
  "supportsSynchronizingFilterState": true,
  "tooltips": {
    "supportedTypes": {
      "default": true
    }
  },
  "sorting": {
    "default": {}
  },
  "drilldown": {
    "roles": []
  }
}
