{
  "name": "dynamic-slicer",
  "version": "0.2.0.4",
  "private": true,
  "description": "Power BI slicer with a dynamic default selection that falls back to a visible value when row-level security hides the default",
  "scripts": {
    "start": "pbiviz start",
    "package": "pbiviz package",
    "eslint": "npx eslint .",
    "preview:style": "node tools/style-preview-server.js",
    "validate": "pbiviz package --resources --no-minify"
  },
  "dependencies": {
    "powerbi-visuals-api": "~5.11.1",
    "powerbi-visuals-utils-formattingmodel": "^7.1.0",
    "powerbi-visuals-utils-formattingutils": "^6.1.2"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-plugin-powerbi-visuals": "^1.1.1",
    "powerbi-visuals-tools": "^7.2.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "qs": "^6.17.0",
    "uuid": "^11.1.1"
  },
  "license": "MIT"
}
